{
  "manifest_version": 2,
  "name": "Zotero Patent Helper",
  "version": "2.2",
  "description": "从中国专利网抓取专利元数据并下载 PDF",
  "icons": {
    "48": "content/icons/favicon@0.5x.png",
    "96": "content/icons/favicon.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-patent@local",
      "update_url": "https://github.com/{{owner}}/{{repo}}/releases/download/release/update.json",
      "strict_min_version": "6.999",
      "strict_max_version": "9.*"
    }
  }
}
